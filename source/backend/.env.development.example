# Local development: mocked AI keeps development usable without external credentials.
# AI_PROVIDER=mock uses local simulated replies for development and defense demos.
# For real DeepSeek, set AI_PROVIDER=deepseek and fill in a valid key below.
DEBUG=true
DATABASE_URL=mysql+pymysql://zjiaotong_app:replace_me@127.0.0.1:3306/zjiaotong
SECRET_KEY=replace-with-a-long-random-development-secret
AI_PROVIDER=mock
DEEPSEEK_API_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
# Required only when AI_PROVIDER=deepseek. Never commit a real API key.
DEEPSEEK_API_KEY=
CAPTCHA_PROVIDER=disabled
CAPTCHA_BYPASS=true
CORS_ORIGINS=["http://127.0.0.1:3000","http://localhost:3000"]
FRONTEND_URL=http://127.0.0.1:3000
